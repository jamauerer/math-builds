    { "line": "The river is cold. I checked.", "cause": "general" },
    { "line": "My horns are fine. My pride is not.", "cause": "general" },
    { "line": "I looked at the water. The water looked back.", "cause": "general" },
    { "line": "You can build it again. I will wait right here.", "cause": "general" },
    { "line": "I prefer grass. This was not grass.", "cause": "general" },
    { "line": "The fish were not expecting me.", "cause": "general" },
    { "line": "We can call that a practice dunk.", "cause": "general" },
    { "line": "I am still a goat. The bridge is not still a bridge.", "cause": "general" },
    { "line": "The banks were right there.", "cause": "general" },
    { "line": "I have four legs and none of them swim well.", "cause": "general" },
